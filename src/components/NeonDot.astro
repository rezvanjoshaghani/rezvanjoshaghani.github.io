---
interface Props {
  color: string;
  size?: number;
}
const { color, size = 6 } = Astro.props;
---
<span
  class="neon-dot"
  style={`width: ${size}px; height: ${size}px; background: ${color}; box-shadow: 0 0 8px ${color}60;`}
></span>

<style>
  .neon-dot {
    display: inline-block;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
  }
</style>
