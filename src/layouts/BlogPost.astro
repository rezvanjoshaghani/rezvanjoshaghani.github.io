---
import BaseLayout from './BaseLayout.astro';
import NeonTag from '../components/NeonTag.astro';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  dotColor: string;
}

const { title, date, description, tags, dotColor } = Astro.props;
const neonColors = ['#00F0FF', '#FF3CAC', '#22D65A', '#FFE03D', '#845EF7'];
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={`${title} — Rezvan Joshaghani`} description={description} currentPage="Blog">
  <article class="page-content fade-in">
    <a href="/blog/" class="back-link font-outfit">&larr; Back to blog</a>
    <header class="post-header">
      <h1 class="post-title font-outfit">{title}</h1>
      <div class="post-meta">
        <span class="post-date font-mono">{formattedDate}</span>
        <div class="post-tags">
          {tags.map((tag, i) => (
            <NeonTag color={neonColors[i % neonColors.length]}>{tag}</NeonTag>
          ))}
        </div>
      </div>
    </header>
    <div class="post-content font-crimson">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 32px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #00F0FF;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-title {
    font-size: 28px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.5px;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .post-date {
    font-size: 12px;
    color: var(--muted);
  }

  .post-tags {
    display: flex;
    gap: 6px;
  }

  .post-content {
    font-size: 17px;
    color: var(--secondary);
    line-height: 1.8;
  }

  .post-content :global(p) {
    margin-bottom: 20px;
  }

  .post-content :global(h2) {
    font-family: 'Outfit', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--text);
    margin-top: 36px;
    margin-bottom: 16px;
  }

  .post-content :global(h3) {
    font-family: 'Outfit', sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
    margin-top: 28px;
    margin-bottom: 12px;
  }

  .post-content :global(code) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 3px;
  }

  .post-content :global(pre) {
    background: var(--code-bg);
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 20px;
  }

  .post-content :global(a) {
    color: #00F0FF;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid #00F0FF;
    padding-left: 20px;
    color: var(--muted);
    margin-bottom: 20px;
  }
</style>
