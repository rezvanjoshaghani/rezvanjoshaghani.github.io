---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeonTag from '../components/NeonTag.astro';
---
<BaseLayout
  title="About | Rezvan Joshaghani"
  description="PhD candidate in Computer Science at Boise State University. Research in neural rendering, 3DGS compression, and XR education."
  currentPage="About"
>
  <div class="page-content fade-in">
    <h1 class="page-title font-outfit">About</h1>
    <div class="about-grid">
      <div class="about-left">
        <div class="photo-frame gradient-animated">
          <img src="/images/avatar.jpeg" alt="Rezvan Joshaghani" class="photo-img" />
        </div>
        <div class="contact-info">
          <div class="contact-item">
            <div class="contact-label font-outfit">Email</div>
            <div class="contact-value font-outfit">rezvanjoshaghani@u.boisestate.edu</div>
          </div>
        </div>
      </div>
      <div class="about-right font-crimson">
        <p>
          I'm a PhD candidate in Computer Science at Boise State University, working with
          <span class="text-strong">Steve Cutchin</span>. My research sits at the intersection of
          <span class="neon-inline" style="--neon-color: #00F0FF;">computer vision</span>,
          <span class="neon-inline" style="--neon-color: #FF3CAC;">graphics</span>, and
          <span class="neon-inline" style="--neon-color: #22D65A;">AI</span>.
        </p>
        <p>
          I focus on neural 3D reconstruction and efficient scene representation, studying how systems
          like Neural Radiance Fields and 3D Gaussian Splatting can be optimized for perceptual quality,
          compression, and practical usability. My work explores how loss functions, scene complexity,
          and super-resolution affect the quality of reconstructed 3D scenes.
        </p>
        <p>
          I'm especially interested in building AI tools and 3D systems that move beyond benchmark
          performance and become useful, accessible technologies for researchers, creators, educators,
          and everyday users.
        </p>
        <p class="last-para">
          My published work also spans
          <span class="neon-inline" style="--neon-color: #22D65A;">XR</span>, including
          VR training modules for chemistry labs (IEEE TVCG), immersive technology in
          undergraduate science education (IEEE VR), and VR/MR collaboration systems, as well as
          <span class="neon-inline" style="--neon-color: #845EF7;">privacy</span>, where I've worked on
          formal verification of privacy policies and equitable privacy protections (FAT*).
        </p>
        <div class="tag-row">
          <NeonTag color="#00F0FF">Computer Vision</NeonTag>
          <NeonTag color="#FF3CAC">Neural Rendering</NeonTag>
          <NeonTag color="#22D65A">3D Reconstruction</NeonTag>
          <NeonTag color="#FFE03D">XR/VR</NeonTag>
          <NeonTag color="#845EF7">Privacy</NeonTag>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-title {
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.5px;
    margin-bottom: 40px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 48px;
  }

  .photo-frame {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    padding: 2px;
  }

  .photo-img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: cover;
    background: var(--photo-bg);
  }

  .contact-info {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-label {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .contact-value {
    font-size: 13px;
    color: var(--secondary);
  }

  .about-right {
    font-size: 16px;
    color: var(--secondary);
    line-height: 1.8;
  }

  .about-right p {
    margin-bottom: 20px;
  }

  .about-right .last-para {
    margin-bottom: 28px;
  }

  .text-strong {
    color: var(--text);
  }

  .neon-inline {
    color: var(--neon-color);
    font-weight: 500;
  }

  [data-theme="dark"] .neon-inline {
    text-shadow: 0 0 12px color-mix(in srgb, var(--neon-color) 30%, transparent);
  }

  .tag-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .photo-frame {
      max-width: 200px;
    }
  }
</style>
