---
import BaseLayout from '../layouts/BaseLayout.astro';
import CVEntry from '../components/CVEntry.astro';
---
<BaseLayout
  title="CV | Rezvan Joshaghani"
  description="Curriculum Vitae of Rezvan Joshaghani. Education, experience, publications, and technical skills."
  currentPage="CV"
>
  <div class="page-content fade-in">
    <div class="cv-header">
      <h1 class="page-title font-outfit">Curriculum Vitae</h1>
    </div>

    <!-- Education -->
    <section class="cv-section">
      <h2 class="cv-section-title font-outfit">Education</h2>
      <CVEntry
        period="2019 – present"
        title="Ph.D. in Computer Science (expected 2026)"
        place="Boise State University"
        detail="Advisor: Steve Cutchin. Neural 3D reconstruction, perceptual optimization, scene complexity, compression, and super-resolution."
        color="#00F0FF"
      />
      <CVEntry
        title="M.S. in Computer Science"
        place="Boise State University"
        color="#22D65A"
      />
      <CVEntry
        title="B.S. in Software Engineering"
        place="K. N. Toosi University of Technology"
        color="#FFE03D"
      />
    </section>

    <!-- Experience -->
    <section class="cv-section">
      <h2 class="cv-section-title font-outfit">Experience</h2>
      <CVEntry
        period="Aug 2019 – present"
        title="Ph.D. Research Assistant"
        place="Boise State University"
        detail="Neural rendering, 3D reconstruction, perceptual optimization. Led development on NSF-funded Chemistry VR app, Stain Luminary visualization cave, and Atlas of Drowned Towns."
        color="#00F0FF"
      />
      <CVEntry
        period="Jan – May 2023"
        title="Research Scientist Intern"
        place="Silverdraft SuperComputing"
        detail="Designed and integrated a VR/MR collaboration application for Autodesk VRED with Varjo XR-3."
        color="#FF3CAC"
      />
      <CVEntry
        period="Jun – Aug 2019"
        title="Full-Stack Software Engineer Intern"
        place="Symantec"
        detail="Built a configurable Unified Reporting dashboard for SDLC and QA metrics."
        color="#845EF7"
      />
      <CVEntry
        period="Aug 2017 – May 2019"
        title="Research Assistant"
        place="Boise State University"
        detail="Formal verification of privacy preferences, algorithmic fairness, and children's understanding of privacy."
        color="#22D65A"
      />
    </section>

    <!-- Awards -->
    <section class="cv-section">
      <h2 class="cv-section-title font-outfit">Honors</h2>
      <CVEntry
        title="Story Collider Fellowship"
        detail="STEM communication"
        place="Boise State University"
      />
      <CVEntry
        title="Graduate Showcase Awards"
        detail="Computer Science and Cybersecurity"
        place="Boise State University"
      />
      <CVEntry
        title="Audience Choice Award"
        detail="Three Minute Thesis Competition"
        place="Boise State University"
      />
    </section>

    <!-- Patent -->
    <section class="cv-section">
      <h2 class="cv-section-title font-outfit">Patent</h2>
      <CVEntry
        period="2013"
        title="A Navigational Aid for the Visually Impaired"
        place="Tehran, Iran"
        color="#FFE03D"
      />
    </section>

    <!-- Technical -->
    <section class="cv-section">
      <h2 class="cv-section-title font-outfit">Technical</h2>
      <div class="tech-row">
        <span class="tech-label font-mono">Languages</span>
        <span class="tech-value font-outfit">Python, C++, JavaScript, TypeScript</span>
      </div>
      <div class="tech-row">
        <span class="tech-label font-mono">ML / Vision</span>
        <span class="tech-value font-outfit">PyTorch, 3DGS, NeRF, Hugging Face, deep learning, perceptual metrics</span>
      </div>
      <div class="tech-row">
        <span class="tech-label font-mono">Platforms</span>
        <span class="tech-value font-outfit">React, Angular, Unity, Docker, Terraform, AWS, GCP</span>
      </div>
      <div class="tech-row">
        <span class="tech-label font-mono">Infrastructure</span>
        <span class="tech-value font-outfit">SLURM/HPC, GPU pipelines, PostgreSQL, Elasticsearch, REST APIs</span>
      </div>
      <div class="tech-row">
        <span class="tech-label font-mono">XR</span>
        <span class="tech-value font-outfit">Meta Quest, Varjo XR-3, Autodesk VRED, VR/AR/XR applications</span>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .page-title {
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.5px;
  }

  .cv-section {
    margin-bottom: 44px;
  }

  .cv-section-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .tech-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
    margin-bottom: 10px;
  }

  .tech-label {
    font-size: 12px;
    color: var(--muted);
  }

  .tech-value {
    font-size: 14px;
    color: var(--secondary);
  }

  @media (max-width: 768px) {
    .tech-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
