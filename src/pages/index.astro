---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeonTag from '../components/NeonTag.astro';
import NeonDot from '../components/NeonDot.astro';
import publications from '../data/publications.json';
import { getCollection } from 'astro:content';

const catColors: Record<string, string> = {
  'XR': '#22D65A',
  'Privacy': '#845EF7',
};

const recentPubs = publications.slice(0, 3).map(p => ({
  title: p.title,
  venue: p.venue.split(',')[0],
  dot: catColors[p.category] || '#00F0FF',
}));

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map(p => ({
    title: p.data.title,
    date: p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' }),
    dot: p.data.dotColor,
    slug: p.slug,
  }));
---
<BaseLayout title="Rezvan Joshaghani | PhD Candidate, Computer Science" currentPage="Home">
  <div class="page-content fade-in">
    <!-- Hero -->
    <div class="hero">
      <div class="hero-header">
        <h1 class="hero-name font-outfit">Rezvan Joshaghani</h1>
        <p class="hero-title font-outfit">PhD Candidate &middot; Computer Science &middot; Boise State University</p>
      </div>

      <p class="hero-bio font-crimson">
        My research sits at the intersection of
        <span class="neon-inline" style="--neon-color: #00F0FF;">computer vision</span>,
        <span class="neon-inline" style="--neon-color: #FF3CAC;">graphics</span>, and
        <span class="neon-inline" style="--neon-color: #22D65A;">AI</span>.
        I focus on neural 3D reconstruction, optimizing systems like NeRF and 3D Gaussian Splatting
        for perceptual quality, compression, and real-world usability.
      </p>

      <div class="tag-row">
        <NeonTag color="#00F0FF">Computer Vision</NeonTag>
        <NeonTag color="#FF3CAC">Neural Rendering</NeonTag>
        <NeonTag color="#22D65A">3D Reconstruction</NeonTag>
        <NeonTag color="#FFE03D">XR/VR</NeonTag>
      </div>
    </div>

    <!-- Gradient divider -->
    <div class="gradient-divider"></div>

    <!-- Recent Publications -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title font-outfit">Recent Publications</h2>
        <a href="/research/" class="section-link font-outfit">View all &rarr;</a>
      </div>
      {recentPubs.map(p => (
        <a href="/research/" class="list-row hover-row" style="text-decoration: none;">
          <NeonDot color={p.dot} />
          <span class="list-row-title font-crimson">{p.title}</span>
          <span class="list-row-meta font-mono">{p.venue}</span>
        </a>
      ))}
    </section>

    <!-- Recent Posts -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title font-outfit">Recent Posts</h2>
        <a href="/blog/" class="section-link font-outfit">All posts &rarr;</a>
      </div>
      {recentPosts.map(p => (
        <a href={`/blog/${p.slug}/`} class="list-row hover-row" style="text-decoration: none;">
          <NeonDot color={p.dot} />
          <span class="list-row-title font-crimson">{p.title}</span>
          <span class="list-row-meta font-mono">{p.date}</span>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 48px;
  }

  .hero-header {
    margin-bottom: 28px;
  }

  .hero-name {
    font-size: 26px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.5px;
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .hero-title {
    font-size: 13px;
    color: var(--muted);
    font-weight: 400;
  }

  .hero-bio {
    font-size: 17.5px;
    color: var(--secondary);
    line-height: 1.75;
    max-width: 600px;
    margin-bottom: 24px;
  }

  .neon-inline {
    color: var(--neon-color);
    font-weight: 500;
  }

  [data-theme="dark"] .neon-inline {
    text-shadow: 0 0 12px color-mix(in srgb, var(--neon-color) 30%, transparent);
  }

  .tag-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .gradient-divider {
    height: 1px;
    margin-bottom: 48px;
    background: linear-gradient(to right, #00F0FF, #FF3CAC, #22D65A, transparent 80%);
    opacity: 0.5;
  }

  .section {
    margin-bottom: 52px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }

  .section-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .section-link {
    font-size: 12px;
    color: #00F0FF;
    text-decoration: none;
  }

  .list-row {
    padding: 14px 16px;
    margin: 0 -16px;
    display: flex;
    align-items: baseline;
    gap: 16px;
    cursor: pointer;
  }

  .list-row-title {
    font-size: 15.5px;
    color: var(--text);
    line-height: 1.5;
    flex: 1;
  }

  .list-row-meta {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .hero-name {
      font-size: 22px;
    }

    .list-row {
      flex-wrap: wrap;
    }

    .list-row-meta {
      margin-left: 22px;
    }
  }
</style>
